# Common text definitions: blocking lines reused across guard chips
Common: {
	Block1: ■ 挡1：阻挡1个敌人——对阻挡目标+35%伤害，受其伤害-10%
	Block2: ■ 挡2：阻挡2个敌人——对阻挡目标+15%伤害，受其伤害-15%
	Block3: ■ 挡3：阻挡3个敌人——对阻挡目标+5%伤害，受其伤害-20%
	Block4: ■ 挡4：阻挡3个敌人——对阻挡目标+5%伤害，受其伤害-20%
	BlockFalloff: 阻挡增伤/减伤效果随距离衰减：100px内满效，100~300px线性衰减，超过300px无效
}

SniperBaseChip: {
	DisplayName: 基础狙击芯片
	Tooltip: 基础狙击芯片，用以合成各子职业芯片
}

RapidFireChip: {
	DisplayName: 速射狙芯片
	Tooltip: ""
	ChipEngraveName: 速射狙
	ChipTooltip:
		'''
		右键使用：将当前手持的远程武器刻印为【速射狙】
		刻印后获得速射狙天赋：射速↑ 对空特化 轻微追踪
		■ 弹速 +20%
		■ 对空特化：对空中单位伤害 ×1.2
		■ 附近存在地面敌人时，攻速 ×1.15（范围800px）
		■ 对空中单位轻微制导（范围400px）
		空中单位：Y方向速度 ≠ 0 的敌人
		'''
}

ArtilleristChip: {
	DisplayName: 炮手芯片
	Tooltip: ""
	ChipEngraveName: 炮手
	ChipTooltip:
		'''
		右键使用：将当前手持的远程武器刻印为【炮手】
		刻印后获得炮手天赋：攻击附带爆炸、破甲
		■ 命中触发爆炸：造成20%基础伤害，半径24px
		■ 破甲：主命中与爆炸均降低50%防御效果
		■ 对低速敌人（速度≤10）伤害 +10%
		'''
}

MarksmanChip: {
	DisplayName: 神射手芯片
	Tooltip: ""
	ChipEngraveName: 神射手
	ChipTooltip:
		'''
		右键使用：将当前手持的远程武器刻印为【神射手】
		刻印后获得神射手天赋：精准打击、轻微追踪、距离增伤
		■ 精准：对范围内防御最低的敌人伤害 +6%（范围700px）
		■ 距离增伤：400px起，640px达到最高 +15%
		■ 对防御最低目标轻微制导（范围600px）
		未击杀补偿：射弹未击败敌人时，获得+10%远程攻速（持续2秒）
		'''
}

ThrowerChip: {
	DisplayName: 投掷手芯片
	Tooltip: ""
	ChipEngraveName: 投掷手
	ChipTooltip:
		'''
		右键使用：将当前手持的远程武器刻印为【投掷手】
		刻印后获得投掷手天赋：穿透爆炸攻击
		主弹命中造成0.75倍伤害，随后产生两次延迟爆炸
		'''
}

SpreadChip: {
	DisplayName: 散射手芯片
	Tooltip: ""
	ChipEngraveName: 散射手
	ChipTooltip:
		'''
		右键使用：将当前手持的远程武器刻印为【散射手】
		刻印后获得散射手天赋：弹药伤害积累，释放扇形AOE
		每次射击积累弹药伤害，3帧后释放扇形范围攻击
		近距（0-200px）造成75%存储伤害
		远距（200-400px）造成40%存储伤害
		攻速 ×0.85 惩罚
		扇形：180°范围，半径最大400px
		'''
}

HeavyShooterChip: {
	DisplayName: 重射手芯片
	Tooltip: ""
	ChipEngraveName: 重射手
	ChipTooltip:
		'''
		右键使用：将当前手持的远程武器刻印为【重射手】
		刻印后获得重射手天赋：伤害↑ 攻速↓ 近身增伤 角度判定增伤
		■ 伤害 ×1.3，攻速 ×0.75
		■ 近身增伤：240px内 ×1.25（240~400px线性衰减至×1.0）
		■ 角度判定：瞄准方向与目标夹角<45°时 ×1.1
		■ 换枪爆发：切换武器后5秒内攻速爆发（净攻速×1.5衰减至×0.75），冷却20秒
		'''
	SwapBurstStart: 上膛爆发！
	SwapBurstEnd: 爆发结束
	SwapBurstCooldownEnd: 上膛就绪
}

SiegeChip: {
	DisplayName: 攻城手芯片
	Tooltip: ""
	ChipEngraveName: 攻城手
	ChipTooltip:
		'''
		右键使用：将当前手持的远程武器刻印为【攻城手】
		刻印后获得攻城手天赋：体积锁定、近身惩罚、远程增伤、轻微追踪
		■ 自动锁定范围内碰撞箱最大的敌人（搜索范围700px）
		■ 对锁定的最大体积目标伤害 ×1.2
		■ 贴脸（64px内）伤害 ×0.5
		■ 远距（400px外）伤害 ×1.2
		■ 对锁定目标轻微制导（范围600px）
		'''
}

ChipExtractor: {
	DisplayName: 芯片提取器
	Tooltip: ""
	ChipTooltip:
		'''
		右键使用：从当前手持的武器中提取刻印芯片
		消耗50铜币，不消耗本物品
		返还对应的刻印芯片
		'''
	NoWeapon: 请手持一把已刻印的武器！
	RealArknights: 这把武器是明日方舟专属武器，无法提取芯片！
	NoEngraving: 这把武器没有刻印，无法提取芯片！
	UnknownType: 无法识别该武器的刻印类型！
	NoMoney: 你没有足够的铜币！（需要50铜币）
	MissingChip: 警告：未找到对应的芯片类型（{0}），请联系模组作者。
	Success: 已从 {0} 中提取出刻印芯片！消耗了50铜币。
}

ChipsLoad: {
	HoldWeapon: 请手持一把武器再使用芯片！
	WeaponOnly: 芯片只能用于武器！
	RangedOnly: 该芯片只能用于远程武器！
	MeleeOnly: 该芯片只能用于近战武器！
	RealArknights: 这把武器是明日方舟专属武器，无法刻印！
	AlreadyEngraved: 这把武器已经刻印过了！
	EngraveFailed: 刻印失败，请稍后重试。
	EngraveSuccess: 已将 {0} 刻印为【{1}】！
}

HomingOn: 制导：已开启（默认按 J 切换）
HomingOff: 制导：已关闭（默认按 J 切换）
