DreadnoughtChip: {
	DisplayName: 无畏者芯片
	Tooltip: ""
	ChipEngraveName: 无畏者
	ChipTooltip:
		'''
		右键使用：将当前手持的近战武器刻印为【无畏者】
		刻印后获得无畏者天赋：
		■ 挡1：阻挡1个敌人，近战增伤+减伤
		■ 专属增伤：对阻挡目标额外造成15%伤害
		■ 无畏重生：受到致命伤害时，回满血、生命上限降至40%、攻速×1.3（持续6分钟）
		'''
}

CenturionChip: {
	DisplayName: 强攻手芯片
	Tooltip: ""
	ChipEngraveName: 强攻手
	ChipTooltip:
		'''
		右键使用：将当前手持的近战武器刻印为【强攻手】
		刻印后获得强攻手天赋：
		■ 挡2：阻挡2个敌人，近战增伤+减伤
		■ 专属增伤：对被阻挡敌人额外造成12%伤害
		■ 半血减伤：生命高于50%时，受到被阻挡敌人伤害-20%
		■ 溅射传导：攻击命中时，对其他被阻挡敌人造成20%传导伤害
		'''
}

ArtsFighterChip: {
	DisplayName: 术战者芯片
	Tooltip: ""
	ChipEngraveName: 术战者
	ChipTooltip:
		'''
		右键使用：将当前手持的近战武器刻印为【术战者】
		刻印后获得术战者天赋：
		■ 挡1：阻挡1个敌人，近战增伤+减伤
		■ 法术转化：所有伤害和弹幕转为法术伤害
		■ 防御穿透：获得30%防御穿透
		■ 非阻挡增伤：对未被阻挡的目标造成1.12倍伤害
		■ 阻挡易伤：已被阻挡的目标受到伤害+10%
		'''
}

FighterChip: {
