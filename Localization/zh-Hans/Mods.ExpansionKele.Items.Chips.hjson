ReaperChip: {
	DisplayName: 收割者芯片
	Tooltip: ""
	ChipEngraveName: 收割者
	ChipTooltip:
		'''
		右键使用：将当前手持的近战武器刻印为【收割者】
		刻印后获得收割者天赋：
		{$Common.Block2}
		{$Common.BlockFalloff}
		■ 暗夜掠夺：抑制自然生命再生（lifeRegen 与 lifeRegenTime 置零）
		■ 吸血收割：每次命中恢复已损生命值3%
		  限定时间（=武器使用时间）内最多回3次血，用完即锁
		  距离衰减：128px内满效，320px外仅33%
		■ 群战本能：300px内每多一个敌人+6%伤害，最多+12%
		      ■ 复仇印记：攻击收割者的敌人，永久对所有玩家伤害-15%
		      ■ 收割印记：被收割者攻击过的敌人，其对收割者的伤害永久-10%
		'''
}

MushaChip: {
	DisplayName: 武者芯片
	Tooltip: ""
	ChipEngraveName: 武者
	ChipTooltip:
		'''
		右键使用：将当前手持的近战武器刻印为【武者】
		刻印后获得武者天赋：
		{$Common.Block1}
		      {$Common.BlockFalloff}
		■ 绝地求生：抑制自然生命再生（lifeRegen 与 lifeRegenTime 置零）
		■ 借击回生（距离衰减）：每次命中回复已损生命值5%，冷却为武器使用时间
		距离越近回复越多：128px内满效，128~320px衰减至33%，320px外仅33%
		■ 孤注一掷：生命低于50%时获得20%减伤
		■ 愈战愈勇：根据已损生命值（最高70%）线性提升最高50%攻击速度
		■ 不屈意志：死亡时回复30%最大生命值，冷却10分钟，期间再死则真正死亡
		'''
}

CrusherChip: {
	DisplayName: 重剑手芯片
	Tooltip: ""
	ChipEngraveName: 重剑手
	ChipTooltip:
		'''
		右键使用：将当前手持的近战武器刻印为【重剑手】
		刻印后获得重剑手天赋：
		{$Common.Block2}
		{$Common.BlockFalloff}
		■ 玻璃大炮：防御有效性×0（防御不提供减伤）
		■ 重剑破防：每1点防御转化为+0.5%近战伤害加成
		■ 破军之势：自身近战伤害×1.75，攻击速度降至原来的60%
		■ 不屈之躯：生命上限×2，自然回血速度+20%，药水冷却时间缩短17%
		■ 破阵：对已被阻挡的敌人额外造成×1.1伤害
		'''
}

LordChip: {
	DisplayName: 领主芯片
	Tooltip: ""
	ChipEngraveName: 领主
	ChipTooltip:
		'''
		右键使用：将当前手持的近战武器刻印为【领主】
		刻印后获得领主天赋：
		{$Common.Block2}
		      {$Common.BlockFalloff}
		■ 领主剑气：近战攻击时额外发射领主剑气
		  基础伤害60%，速度8，附带20点护甲穿透
		  伤害随飞行距离衰减：128px内满效，320px处降至20%
		■ 武器射弹增益：若武器自带射弹，则在320~128px范围内：
		  伤害从+100%线性递增至+120%
		  穿甲从0%线性递增至10%（128px内最大）
		■ 群战本能：300px内存在至少2个敌人时，近战攻速+12%
		'''
}

LiberatorChip: {
	DisplayName: 解放者芯片
	Tooltip: ""
	ChipEngraveName: 解放者
	ChipTooltip:
		'''
		右键使用：将当前手持的近战武器刻印为【解放者】
		刻印后获得解放者天赋：
		{$Common.Block2}
		      {$Common.BlockFalloff}
		■ 久战积蓄：不使用物品时逐渐充能武器伤害倍率
		  每秒 +0.16 倍，15 秒充能至上限 +2.4 倍（总倍率 1 → 3.4）
		  切换武器保留充能，但不继续增加
		■ 蓄势解放：使用武器时停止充能并进入【解放】状态（持续 10 秒）
		  解放期间维持当前伤害倍率不变
		■ 解放结束：伤害倍率回归初始 1 倍，2 秒内无法再次解放
		■ 常态不阻挡：非解放状态不阻挡敌人
		'''
}

