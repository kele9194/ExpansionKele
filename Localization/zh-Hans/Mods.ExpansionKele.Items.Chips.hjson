	DisplayName: 无畏者芯片
	Tooltip: ""
	ChipEngraveName: 无畏者
	ChipTooltip:
		'''
		右键使用：将当前手持的近战武器刻印为【无畏者】
		刻印后获得无畏者天赋：
		{$Common.Block1}
		      {$Common.BlockFalloff}
		■ 专属增伤：对阻挡目标额外造成15%伤害
		■ 无畏重生：受到致命伤害时，回满血、生命上限降至40%、攻速×1.3（持续6分钟）
		'''
}

