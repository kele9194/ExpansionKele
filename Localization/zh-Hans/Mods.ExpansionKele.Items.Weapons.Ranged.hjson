BurningPaperAirPlane: {
	Tooltip:
		'''
		轻音乐主题(Once)
		扔出一个带破晓减益的纸飞机
		'''
	DisplayName: 燃烧的纸飞机
}

WPSmokeLauncher: {
	DisplayName: 烟雾防空发射器
	Tooltip:
		'''
		发射白磷弹药，在鼠标位置产生烟雾弹集群
		每次发射会产生{0}波烟雾
		鼠标位于玩家上方时激活火控锁定系统
		可以火控锁定鼠标附近的敌人
		优先锁定 Boss 与高威胁目标
		'''
}

LightGap: {
	Tooltip:
		'''
		使用以在散射模式和正常模式循环切换
		散射模式会发射额外的散射子弹
		对空中目标造成额外伤害
		'''
	DisplayName: 光隙
}
