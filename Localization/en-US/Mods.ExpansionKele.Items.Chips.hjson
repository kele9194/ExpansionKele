# Common text definitions: blocking lines reused across guard chips
Common: {
	Block1: ■ Block 1: Blocks 1 enemy — +35% melee damage & -10% damage taken vs blocked
	Block2: ■ Block 2: Blocks 2 enemies — +15% melee damage & -15% damage taken vs blocked
	Block3: ■ Block 3: Blocks 3 enemies — +5% melee damage & -20% damage taken vs blocked
	Block4: ■ Block 4: Blocks 4 enemies — +5% melee damage & -20% damage taken vs blocked
	BlockFalloff: Blocking damage/reduction decays with distance: full within 100px, linear falloff 100-300px, no effect beyond 300px
}

SniperBaseChip: {
	DisplayName: Sniper Base Chip
	Tooltip: Base Sniper Chip, used to synthesize subclass chips
}

RapidFireChip: {
	DisplayName: Rapid Fire Chip
	Tooltip: ""
	ChipEngraveName: Rapid Fire
	ChipTooltip:
		'''
		Right-click: Engrave the held ranged weapon as [Rapid Fire]
		Gain Rapid Fire talent: Increased fire rate, anti-air specialization, slight homing
		■ Projectile speed +20%
		■ Anti-air: +20% damage vs airborne enemies
		■ Attack speed ×1.15 while a ground enemy is nearby (800px)
		■ Light homing toward airborne enemies (400px)
		Airborne enemies: enemies with Y velocity ≠ 0
		'''
}

ArtilleristChip: {
	DisplayName: Artillerist Chip
	Tooltip: ""
	ChipEngraveName: Artillerist
	ChipTooltip:
		'''
		Right-click: Engrave the held ranged weapon as [Artillerist]
		Gain Artillerist talent: Attacks cause explosions and armor break
		■ On hit: trigger an explosion — 20% of base damage, 24px radius
		■ Armor break: defense effectiveness -50% (main hit & explosion)
		■ +10% damage vs slow enemies (speed ≤ 10)
		'''
}

MarksmanChip: {
	DisplayName: Marksman Chip
	Tooltip: ""
	ChipEngraveName: Marksman
	ChipTooltip:
		'''
		Right-click: Engrave the held ranged weapon as [Marksman]
		Gain Marksman talent: Precision strike, light homing, distance damage bonus
		■ Precision: +6% damage vs the lowest-defense enemy in range (700px)
		■ Distance bonus: up to +15% at 640px+ (scales from 400px)
		■ Light homing toward the lowest-defense target (600px)
		Miss compensation: Gain +10% ranged attack speed for 2s when a projectile fails to defeat an enemy
		'''
}

ThrowerChip: {
	DisplayName: Thrower Chip
	Tooltip: ""
	ChipEngraveName: Thrower
	ChipTooltip:
		'''
		Right-click: Engrave the held ranged weapon as [Thrower]
		Gain Thrower talent: Main hit deals 0.75x damage, then triggers two delayed explosions
		First explosion: 0.5s after hit — 0.375x damage, 24px radius
		Second explosion: 1.0s after hit — 0.375x damage, 24px radius
		Total damage: 1.5x base damage
		'''
}

SpreadChip: {
	DisplayName: Spread Chip
	Tooltip: ""
	ChipEngraveName: Spread
	ChipTooltip:
		'''
		Right-click: Engrave the held ranged weapon as [Spread]
		Gain Spread talent: Accumulate ammo damage, release fan-shaped AOE
		Each shot accumulates ammo damage, releases fan-shaped AOE after 3 frames
		Close range (0-200px): 75% of stored damage
		Far range (200-400px): 40% of stored damage
		Attack speed ×0.85 penalty
		Fan: 180° arc, up to 400px
		'''
}

HeavyShooterChip: {
	DisplayName: HeavyShooter Chip
	Tooltip: ""
	ChipEngraveName: HeavyShooter
	ChipTooltip:
		'''
		Right-click to engrave your held ranged weapon as 【HeavyShooter】
		Grants HeavyShooter talent: DMG↑ SPD↓ Close-range bonus Angle bonus
		■ Damage ×1.3, attack speed ×0.75
		■ Close-range bonus: ×1.25 within 240px (decays to ×1.0 at 400px)
		■ Aim bonus: ×1.1 when your aim is within 45° of the target
		■ Weapon swap: attack speed burst for 5s (net ×1.5 → ×0.75), 20s cooldown
		'''
	SwapBurstStart: Chamber Loaded!
	SwapBurstEnd: Burst Ended
	SwapBurstCooldownEnd: Chamber Ready
}

SiegeChip: {
	DisplayName: Siege Chip
	Tooltip: ""
	ChipEngraveName: Siege
	ChipTooltip:
		'''
		Right-click: Engrave the held ranged weapon as [Siege]
		Gain Siege talent: Volume targeting, close penalty, ranged bonus, slight homing
		■ Auto-locks the enemy with the largest hitbox in range (700px)
		■ ×1.2 damage vs the locked largest target
		■ Close range (under 64px): damage ×0.5
		■ Long range (over 400px): damage ×1.2
		■ Light homing toward locked target (600px)
		'''
}

ChipExtractor: {
	DisplayName: Chip Extractor
	Tooltip: ""
	ChipTooltip:
		'''
		Right-click: Extract engraving chip from the held weapon
		Costs 50 copper coins, item is not consumed
		Returns the corresponding engraving chip
		'''
	NoWeapon: Hold an engraved weapon to use the extractor!
	RealArknights: This is an Arknights exclusive weapon, cannot extract chip!
	NoEngraving: This weapon has no engraving, cannot extract chip!
	UnknownType: Unable to recognize the weapon's engraving type!
	NoMoney: Not enough copper coins! (50 copper coins required)
	MissingChip: Warning: No chip type found for {0}, please contact the mod author.
	Success: Extracted engraving chip from {0}! 50 copper coins deducted.
}

ChipsLoad: {
	HoldWeapon: Hold a weapon to use the chip!
	WeaponOnly: Chip can only be used on weapons!
	RangedOnly: This chip can only be used on ranged weapons!
	MeleeOnly: This chip can only be used on melee weapons!
	RealArknights: This is an Arknights exclusive weapon and cannot be engraved!
	AlreadyEngraved: This weapon has already been engraved!
	EngraveFailed: Engraving failed, please try again later.
	EngraveSuccess: '''"{0}" has been engraved as [{1}]!'''
}

HomingOn: Homing: ON (Press button(default J) to toggle)
HomingOff: Homing: OFF (Press button(default J) to toggle)
HomingStatusOn:
	'''
	[Homing ON]
	(Press button(default J) to toggle)
	'''
HomingStatusOff:
	'''
	[Homing OFF]
	(Press button(default J) to toggle)
	'''

TalentDisplayName: {
	RapidFire: 【Talent·Rapid Fire】Increased fire rate, anti-air specialization
	Marksman: 【Talent·Marksman】Increased range, precision strike
	HeavyShooter: 【Talent·Heavy Shooter】High damage, close-range bonus, swap burst
	Artillerist: 【Talent·Artillerist】Attacks cause explosions and armor break
	Thrower: 【Talent·Thrower】Delayed explosive attacks
	Siege: 【Talent·Siege】Lock largest target, ranged bonus, close penalty
	Spread: 【Talent·Spread】Ammo accumulation, fan-shaped area attack
	Dreadnought: 【Talent·Dreadnought】Block 1, blocking damage bonus, Dreadnought Rebirth
	Centurion: 【Talent·Centurion】Block 2, dmg bonus/reduction, splash conduction
	ArtsFighter: 【Talent·ArtsFighter】Block 1, magic conversion, defense penetration, vulnerability
	Fighter: 【Talent·Fighter】Block 1, high attack speed, dodge, hit stacks
	Swordmaster: 【Talent·Swordmaster】Block 2, attack speed, armor pierce, def reduction, crit strike
	Reaper: 【Talent·Reaper】Block 2, suppress life regen, life steal, group damage bonus, Vengeance Mark, Harvest Mark
	Musha: 【Talent·Musha】Block 1, suppress life regen, life steal, low HP dmg reduction, missing HP attack speed, revive
	Crusher: 【Talent·Crusher】Block 2, glass cannon, HP ×2, defense→dmg, 60% attack speed, +20% regen, blocking bonus dmg
	Lord: 【Talent·Lord】Block 2, Lord Slash, projectile boost, group attack speed
	Liberator: 【Talent·Liberator】No block by default, charge-up, liberation burst, Block 2
	Protector: 【Talent·Protector】Block 4, defense effectiveness ×1.2
}

ArknightsTag: "[Arknights] "

GuardBaseChip: {
	DisplayName: Guard Base Chip
	Tooltip: Base Guard Chip, used to synthesize subclass chips
}

DreadnoughtChip: {
	DisplayName: Dreadnought Chip
	Tooltip: ""
	ChipEngraveName: Dreadnought
	ChipTooltip:
		'''
		Right-click: Engrave the held melee weapon as [Dreadnought]
		Gain Dreadnought talent:
		{$Common.Block1}
		      {$Common.BlockFalloff}
		■ Exclusive bonus: +15% damage vs blocked targets
		■ Dreadnought Rebirth: On lethal hit, heal to full, reduce max HP to 40%, gain ×1.3 attack speed (6 min duration)
		'''
}

CenturionChip: {
	DisplayName: Centurion Chip
	Tooltip: ""
	ChipEngraveName: Centurion
	ChipTooltip:
		'''
		Right-click: Engrave the held melee weapon as [Centurion]
		Gain Centurion talent:
		{$Common.Block2}
		      {$Common.BlockFalloff}
		■ Exclusive bonus: +12% damage vs blocked targets
		■ HP safeguard: Take 20% less damage from blocked enemies when HP > 50%
		■ Splash conduction: On hit, deal 20% conduction damage to other blocked enemies
		'''
}

