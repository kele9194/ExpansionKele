ArknightsTag: "[Arknights] "

GuardBaseChip: {
	DisplayName: Guard Base Chip
	Tooltip: Base Guard Chip, used to synthesize subclass chips
}

DreadnoughtChip: {
	DisplayName: Dreadnought Chip
	Tooltip: ""
	ChipEngraveName: Dreadnought
	ChipTooltip:
		'''
		Right-click: Engrave the held melee weapon as [Dreadnought]
		Gain Dreadnought talent:
		■ Block 1: Blocks 1 enemy, melee damage bonus + damage reduction
		■ Exclusive bonus: +15% damage vs blocked targets
		■ Dreadnought Rebirth: On lethal hit, heal to full, reduce max HP to 40%, gain ×1.3 attack speed (6 min duration)
		'''
}

CenturionChip: {
	DisplayName: Centurion Chip
	Tooltip: ""
	ChipEngraveName: Centurion
	ChipTooltip:
		'''
		Right-click: Engrave the held melee weapon as [Centurion]
		Gain Centurion talent:
		■ Block 2: Blocks 2 enemies, melee damage bonus + damage reduction
		■ Exclusive bonus: +12% damage vs blocked targets
		■ HP safeguard: Take 20% less damage from blocked enemies when HP > 50%
		■ Splash conduction: On hit, deal 20% conduction damage to other blocked enemies
		'''
}

ArtsFighterChip: {
