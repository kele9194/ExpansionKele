}

FighterChip: {
	DisplayName: Fighter Chip
	Tooltip: ""
	ChipEngraveName: Fighter
	ChipTooltip:
		'''
		Right-click: Engrave the held melee weapon as [Fighter]
		Gain Fighter talent:
		{$Common.Block1}
		      {$Common.BlockFalloff}
		■ Swift Strikes: Attack speed ×1.25, but damage ×0.80
		■ Base Dodge: Gain 15% dodge chance (max 20% with stacks)
		■ Fighting Spirit: When HP > 50%, +10% melee attack speed
		■ Fighter Stacks: Each hit grants 1 stack of Fighter Buff (2 sec duration)
		  Each stack: +1% dodge chance, +3% attack speed, max 5 stacks
		'''
}

SwordmasterChip: {
	DisplayName: Swordmaster Chip
	Tooltip: ""
	ChipEngraveName: Swordmaster
	ChipTooltip:
		'''
		Right-click: Engrave the held melee weapon as [Swordmaster]
		Gain Swordmaster talent:
		{$Common.Block1}
		      {$Common.BlockFalloff}
		■ Bladestorm: Attack speed ×2.0, but damage ×0.65
		■ Armor Pierce: Attacks ignore 15 flat armor
		■ Sunder: Reduce target's defense effectiveness by 10%
		■ Critical Strike: Final damage ×1.1 (not affected by distance)
		'''
}

ReaperChip: {
	DisplayName: Reaper Chip
	Tooltip: ""
	ChipEngraveName: Reaper
	ChipTooltip:
		'''
		Right-click: Engrave the held melee weapon as [Reaper]
		Gain Reaper talent:
		{$Common.Block2}
		{$Common.BlockFalloff}
		■ Dark Harvest: Suppress natural life regeneration (lifeRegen & lifeRegenTime set to 0)
		■ Blood Siphon: Each hit restores 3% of missing HP
		  At most 3 heals per time window (= weapon use time), locked once used up
		  Distance: full within 128px, 33% beyond 320px
		■ Pack Instinct: +6% damage per additional enemy within 300px, up to +12%
		      ■ Vengeance Mark: Enemies that attack the Reaper permanently deal -15% damage to all players
		      ■ Harvest Mark: Enemies attacked by the Reaper permanently deal -10% damage to this Reaper
		'''
}

MushaChip: {
	DisplayName: Musha Chip
	Tooltip: ""
	ChipEngraveName: Musha
	ChipTooltip:
		'''
		Right-click: Engrave the held melee weapon as [Musha]
		Gain Musha talent:
		{$Common.Block1}
		      {$Common.BlockFalloff}
		■ Last Stand: Suppress natural life regeneration (lifeRegen & lifeRegenTime set to 0)
		■ Life Steal Strike: Each hit restores 5% of missing HP, cooldown equals weapon use time
		  (distance: full within 128px, 33% beyond 320px)
		■ Desperate Gamble: Take 20% less damage when HP ≤ 50%
		■ Indomitable: Up to 50% attack speed bonus scaling linearly with missing HP (max 70%)
		■ Unyielding Will: On death, revive with 30% max HP (10 min cooldown), true death if killed again
		'''
}

CrusherChip: {
	DisplayName: Crusher Chip
	Tooltip: ""
	ChipEngraveName: Crusher
	ChipTooltip:
		'''
		Right-click: Engrave the held melee weapon as [Crusher]
		Gain Crusher talent:
		{$Common.Block2}
		■ Glass Cannon: Defense effectiveness ×0 (defense provides no damage reduction)
		■ Heavy Strike: Each point of defense grants +0.5% melee damage
		■ Crushing Force: Own melee damage ×1.75, attack speed reduced to 60%
		■ Unyielding Body: Max HP ×2, natural life regen +20%，Potion cooldown reduced by 17%
		■ Break Formation: Deal ×1.1 damage to blocked enemies
		'''
}

LordChip: {
	DisplayName: Lord Chip
	Tooltip: ""
	ChipEngraveName: Lord
	ChipTooltip:
		'''
		Right-click: Engrave the held melee weapon as [Lord]
		Gain Lord talent:
		{$Common.Block2}
		      {$Common.BlockFalloff}
		■ Lord Slash: Melee attacks fire an additional Lord Slash projectile
		  Base damage 60%, speed 8, +20 armor penetration
		  Damage decays with distance: 60% at 128px, 20% at 320px
		■ Projectile Boost: If the weapon itself fires projectiles, within 128~320px:
		  Damage bonus: +100% → +120% (scales with proximity)
		  Armor penetration: 0% → 10% (scales with proximity)
		■ Battle Momentum: +12% melee attack speed when 2+ enemies within 300px
		'''
}

LiberatorChip: {
	DisplayName: Liberator Chip
	Tooltip: ""
	ChipEngraveName: Liberator
	ChipTooltip:
		'''
		Right-click: Engrave the held melee weapon as [Liberator]
		Gain Liberator talent:
		{$Common.Block2}
		      {$Common.BlockFalloff}
		■ Endurance Charge: Weapon damage multiplier charges up while not using items
		  +0.16 per second, caps at +2.4 after 15s (total multiplier 1 → 3.4)
		  Switching weapons keeps the charge but stops charging
		■ Liberation: Using a weapon stops charging and enters [Liberation] (10s)
		  The damage multiplier is maintained during Liberation
		■ After Liberation: multiplier resets to 1×, cannot re-liberate for 2s
		■ No Block by default: does not block enemies outside Liberation
		'''
}

