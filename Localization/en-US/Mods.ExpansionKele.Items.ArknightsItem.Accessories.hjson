LiberatorChip: {
	DisplayName: Liberator Chip
	Tooltip: ""
	InactiveHint: Activate by equipping it or favoriting it in your inventory
	NoStackHint: Equipped and favorited effects do not stack
	ShiftHint: Hold Shift to view both equipped and favorited effects
	EquippedDetailed:
		'''
		When equipped:
		While you are not swinging a weapon, charge accumulates at +0.16 per second, reaching the 1.12 cap in 7 seconds
		Attacking with a melee weapon while charging immediately enters Liberation for 10 seconds
		During Liberation, melee damage is multiplied by (1 + charge), up to x2.12 at full charge
		When Liberation ends, charge resets to 0 and cannot be triggered again for 2 seconds
		'''
	FavoritedDetailed:
		'''
		While favorited:
		Charge accumulates automatically over time at +0.04 per second, reaching the 0.24 cap in 6 seconds
		It accumulates whether or not you are attacking, and grants no damage bonus while charging
		A full gauge automatically enters Liberation for 3 seconds
		During Liberation, melee damage is multiplied by (1 + charge), up to x1.24 at full charge
		When Liberation ends, charge resets to 0 and cannot be triggered again for 2 seconds
		'''
}

PrimalGuardChip: {
	DisplayName: Primal Guard Chip
	Tooltip: ""
	InactiveHint: Activate by equipping it or favoriting it in your inventory
	NoStackHint: Equipped and favorited effects do not stack
	ShiftHint: Hold Shift to view both equipped and favorited effects
	EquippedDetailed:
		'''
		When equipped:
		10% increased melee damage
		Melee hits accumulate elemental damage equal to 25% of the damage dealt
		At 4% of the target's maximum life it detonates, dealing true damage equal to 4% of the target's maximum life (ignores defense)
		For 8 seconds after detonating, your melee damage is converted into true damage (never lower than the original damage)
		'''
	FavoritedDetailed:
		'''
		While favorited:
		4% increased melee damage
		Melee hits accumulate elemental damage equal to 20% of the damage dealt
		At 4% of the target's maximum life it detonates, dealing true damage equal to 2% of the target's maximum life (ignores defense)
		After detonating, that target cannot accumulate elemental damage for 8 seconds; no true damage window is granted
		'''
}
