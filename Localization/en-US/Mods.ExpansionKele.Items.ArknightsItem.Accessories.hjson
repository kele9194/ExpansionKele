MushaChip: {
	DisplayName: Musha Chip
	Tooltip: ""
	InactiveHint: Activate by equipping it or favoriting it in your inventory
	NoStackHint: Equipped and favorited effects do not stack
	ShiftHint: Hold Shift to view both equipped and favorited effects
	EquippedDetailed:
		'''
		When equipped:
		Natural life regeneration is disabled (healing potions and the Nurse still work)
		Each melee swing that hits restores 4% of missing life (at least 1)
		As life is lost, gain up to ×1.5 melee attack speed and +50% melee damage, reaching the cap at 70% life lost
		'''
	FavoritedDetailed:
		'''
		While favorited:
		No healing and no regeneration penalty
		As life is lost, gain up to ×1.15 melee attack speed and +15% melee damage, reaching the cap at 70% life lost
		'''
}

