RapidFireChip: {
	DisplayName: Rapid-Fire Sniper Chip
	Tooltip: ""
	InactiveHint: Activate by equipping it or favoriting it in your inventory
	NoStackHint: Equipped and favorited effects do not stack
	ShiftHint: Hold Shift to view both equipped and favorited effects
	EquippedDetailed:
		'''
		When equipped:
		3% increased ranged damage, plus 15% extra ranged damage against aerial targets
		'''
	FavoritedDetailed:
		'''
		While favorited:
		1% increased ranged damage, plus 5% extra ranged damage against aerial targets
		'''
	ActiveStatus: Active: {0}
	TierEquippedChip: Rapid-Fire Sniper Chip (equipped)
	TierEquippedModule: Rapid-Fire Sniper Chip Module (equipped)
	TierFavoritedChip: Rapid-Fire Sniper Chip (favorited)
	TierFavoritedModule: Rapid-Fire Sniper Chip Module (favorited)
}

RapidFireChipModule: {
	DisplayName: Rapid-Fire Sniper Chip Module
	Tooltip: ""
	InactiveHint: Activate by equipping it or favoriting it in your inventory
	NoStackHint: Equipped and favorited effects do not stack; overlapping stats do not stack with the base chip
	ShiftHint: Hold Shift to view both equipped and favorited effects
	EquippedDetailed:
		'''
		When equipped:
		3% increased ranged damage, plus 15% extra ranged damage against aerial targets
		Enemies lose 1 defense each time you damage them, up to 15
		'''
	FavoritedDetailed:
		'''
		While favorited:
		1% increased ranged damage, plus 5% extra ranged damage against aerial targets
		Defense reduction cap lowered to 5
		'''
}

HeavyShooterChip: {
	DisplayName: Heavy Shooter Chip
	Tooltip: ""
	InactiveHint: Activate by equipping it or favoriting it in your inventory
	NoStackHint: Equipped and favorited effects do not stack
	ShiftHint: Hold Shift to view both equipped and favorited effects
	EquippedDetailed:
		'''
		When equipped:
		4% increased ranged damage and 8% increased ranged crit chance
		Gain 20%-50% armor penetration as the distance closes (600px-240px)
		And gain a linearly increasing 1.5x-3x knockback bonus
		'''
	FavoritedDetailed:
		'''
		While favorited:
		1% increased ranged damage and 2% increased ranged crit chance
		Gain 10%-25% armor penetration as the distance closes (600px-240px)
		And gain a linearly increasing 1.25x-2x knockback bonus
		'''
}

